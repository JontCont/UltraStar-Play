# Copy this file to .env in the same folder and adjust the paths.
# .env is git-ignored. Values may use %VAR% or $VAR references.
# Precedence: command-line flag, then process environment, then .env.

# UltraStar song library that receives published charts (required unless --library is given).
ULTRASTAR_LIBRARY=%USERPROFILE%\Music\UltraStar Play

# Work folder root; each song gets <root>\<artist>-<title>.
ULTRASTAR_WORK_ROOT=%LOCALAPPDATA%\UltraStarSongImport
